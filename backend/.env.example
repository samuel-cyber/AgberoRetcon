PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agberorecon

# The dashboard's dev server also defaults to port 3000. Run it on another port
# (`npm run dev -- -p 3001`) and point NEXT_PUBLIC_API_URL at this backend.

# Set this when deploying behind a proxy/load balancer if needed.
# Required to be "true" whenever USSD_ALLOWED_IPS is set, otherwise every
# request appears to come from the proxy's address and is rejected.
TRUST_PROXY=false

# Optional. Comma-separated IPs or IPv4 CIDR blocks allowed to call the USSD
# callbacks (/ussd and /ussd/agent). Use Africa's Talking's published ranges in
# production. Leave empty to allow any caller (fine for local testing, not for a
# public deployment).
# Example: USSD_ALLOWED_IPS=196.201.212.0/24,196.201.213.0/24
USSD_ALLOWED_IPS=

# Optional. Shared secret required on POST /ussd, sent either as a ?secret=
# query parameter on the callback URL or an x-ussd-secret header. Leave empty
# to disable.
USSD_SHARED_SECRET=

# Optional. Shared secret for the agent callback (POST /ussd/agent, and the
# agent menu on POST /ussd). Falls back to USSD_SHARED_SECRET when unset, which
# is right when both shortcodes belong to the same Africa's Talking app.
AGENT_USSD_SHARED_SECRET=

# Optional. The agent shortcode's serviceCode, e.g. *384*99#. When set, POST
# /ussd serves the agent menu whenever the callback's `serviceCode` matches it,
# so one callback URL can serve both the driver and agent shortcodes.
AGENT_SERVICE_CODE=

# Optional. When set, GET /transactions, /transactions/summary and
# /vehicles/:plate/status require ?key=<value> or an x-api-key header. Leave
# empty for a public read-only ledger (nice for judges watching the demo).
DASHBOARD_API_KEY=

# Optional. Comma-separated browser origins allowed to call the dashboard API.
# Leave empty to allow any origin, which suits a read-only public ledger.
# Example: CORS_ALLOWED_ORIGINS=https://agberorecon.vercel.app
CORS_ALLOWED_ORIGINS=

# Optional. Set to 1 to skip the database-backed loop test in `npm test`.
# SKIP_DB_TESTS=1

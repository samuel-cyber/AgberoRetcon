PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agberorecon

# Set this when deploying behind a proxy/load balancer if needed.
# Required to be "true" whenever USSD_ALLOWED_IPS is set, otherwise every
# request appears to come from the proxy's address and is rejected.
TRUST_PROXY=false

# Optional. Comma-separated IPs or IPv4 CIDR blocks allowed to call POST /ussd.
# Use Africa's Talking's published ranges in production. Leave empty to allow
# any caller (fine for local testing, not for a public deployment).
# Example: USSD_ALLOWED_IPS=196.201.212.0/24,196.201.213.0/24
USSD_ALLOWED_IPS=

# Optional. Shared secret required on POST /ussd, sent either as a ?secret=
# query parameter on the callback URL or an x-ussd-secret header. Leave empty
# to disable.
USSD_SHARED_SECRET=
